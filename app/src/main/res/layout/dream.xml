<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the mockup and CleanYourTV's own Clock screensaver: Outfit, a thin clock with the date
     under it bottom-left, the photographer's name bottom-right. Stacking order, bottom to top: the 4K
     video (on the TV's video layer, behind the window), the two images, the black veil used to fade
     between videos, then the text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <SurfaceView
        android:id="@+id/photo_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/photo_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/photo_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/overlay_margin"
        android:layout_marginBottom="@dimen/overlay_margin"
        android:orientation="vertical">

        <com.mtdetc.picturewindow.dream.ShadowTextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_extralight"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:textColor="@color/overlay_text"
            android:textSize="@dimen/clock_text" />

        <com.mtdetc.picturewindow.dream.ShadowTextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/date_indent"
            android:layout_marginTop="@dimen/date_gap"
            android:fontFamily="@font/outfit_regular"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/overlay_text"
            android:textSize="@dimen/date_text" />
    </LinearLayout>

    <!-- What the photo shows, then "Photo by …" (up to two lines for long observatory credits), then
         the place. -->
    <LinearLayout
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/overlay_margin"
        android:layout_marginBottom="@dimen/credit_margin_bottom"
        android:gravity="end"
        android:orientation="vertical">

        <com.mtdetc.picturewindow.dream.ShadowTextView
            android:id="@+id/about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/about_gap"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_regular"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="@dimen/credit_max_width"
            android:textColor="@color/overlay_text"
            android:textSize="@dimen/about_text"
            android:visibility="gone" />

        <com.mtdetc.picturewindow.dream.ShadowTextView
            android:id="@+id/credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_regular"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="@dimen/credit_max_width"
            android:textColor="@color/overlay_text"
            android:textSize="@dimen/credit_text" />

        <com.mtdetc.picturewindow.dream.ShadowTextView
            android:id="@+id/place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/place_gap"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.08"
            android:maxWidth="@dimen/credit_max_width"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/overlay_text_soft"
            android:textSize="@dimen/place_text"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
